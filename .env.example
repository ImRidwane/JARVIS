# Copy this file to .env and fill in your real keys.
# Never commit the actual .env file to GitHub.

# Conversation (required)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Weather via Tomorrow.io (required for the weather tools)
TOMORROW_API_KEY=your-tomorrow-io-key-here
WEATHER_LOCATION=Harrisburg, PA

# Optional tuning
JARVIS_MAX_STEPS=6          # max tool-calling rounds per turn
JARVIS_MAX_HISTORY=16       # messages kept in context
JARVIS_VOICE=1              # 0 = text only, no microphone or TTS
JARVIS_WORKSPACE=           # file-tool sandbox root, defaults to cwd
JARVIS_STATE_DIR=           # memory + transcript location, defaults to ~/.jarvis
